{
  "expo": {
    "name": "Countdown",
    "slug": "countdown",
    "scheme": "countdown",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.anirudhkille.countdown",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F1419"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.anirudhkille.countdown",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#D9B44A"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Countdown needs calendar access so you can import events into your countdowns."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1419"
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d189d058-644a-41e1-9707-572fcd232310"
      }
    },
    "owner": "anirudhkille",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d189d058-644a-41e1-9707-572fcd232310"
    }
  }
}
